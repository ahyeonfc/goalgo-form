{
  "id": "dribble",
  "name": "드리블",
  "ver": "2026-11-27",
  "doc": "docs/lesson/01-dribble.md",
  "tasks": [
    {"id": "A", "name": "슬라럼 왕복", "cones": [{"n": 6, "gap": 2.0, "first": 1.0}], "fps_min": 30,
     "cam": {"pos": "출발선 뒤 3m", "h": 1.5}, "reps": {"ball": 2, "noball": 1}, "warmup": 0},
    {"id": "B", "name": "8자", "cones": [{"n": 2, "gap": 3.0}], "fps_min": 30,
     "cam": {"pos": "두 콘을 잇는 선 옆 5m", "h": 1.5}, "reps": {"ball": 2, "noball": 1}, "warmup": 0}
  ],
  "metrics": [
    {"id": "drb.time", "name": "코스 시간", "axis": "speed", "unit": "초", "trust": "high", "course": true,
     "calc": {"op": "val", "a": "time_ball"}, "ref": "R1", "dp": 2},
    {"id": "drb.loss", "name": "드리블 손실", "axis": "speed", "unit": "초", "trust": "high", "course": true,
     "calc": {"op": "sub", "a": "time_ball", "b": "time_noball"}, "ref": "R2", "dp": 2,
     "score": {"lo": 0, "hi": 4.06, "t": 1.06}, "note": "유소년 14세 평균 기준",
     "fix": {"above": "공 없이 달릴 때보다 많이 느립니다. 콘 구간에서 터치를 작게, 공을 발 앞에 두고 몸이 공을 따라가게 하세요."}},
    {"id": "drb.speed_avg", "name": "평균 속도", "axis": "speed", "unit": "m/s", "trust": "high", "course": true,
     "calc": {"op": "val", "a": "speed_avg"}, "ref": "R3", "dp": 2},
    {"id": "drb.speed_max", "name": "최고 속도", "axis": "speed", "unit": "m/s", "trust": "mid", "course": true,
     "calc": {"op": "val", "a": "speed_max"}, "dp": 2, "better": "high"},
    {"id": "drb.accuracy", "name": "정확도(콘 건드림)", "axis": "speed", "unit": "회", "trust": "high", "course": true,
     "calc": {"op": "val", "a": "cone_hits"}, "ref": "R4", "dp": 0,
     "score": {"lo": 0, "hi": 0, "t": 5}, "note": "1회당 −20점",
     "fix": {"above": "콘을 건드렸습니다. 콘에 가까워지기 전에 터치를 줄이고 경로를 좁게 잡으세요."}},
    {"id": "drb.touch_rate", "name": "볼터치 빈도", "axis": "perf", "unit": "회/초", "trust": "mid",
     "calc": {"op": "val", "a": "touch_rate"}, "ref": "R5", "dp": 2,
     "score": {"lo": 2.8, "hi": null, "t": 0.7}, "note": "U13 준엘리트 연구 기준(표본 10명)",
     "fix": {"below": "한 번 크게 차고 여러 걸음 뜁니다. 걸음을 짧고 빠르게, 한두 걸음마다 한 번씩 터치하세요."}},
    {"id": "drb.touch_even", "name": "볼터치 고르기", "axis": "perf", "unit": "%", "trust": "mid",
     "calc": {"op": "val", "a": "touch_even"}, "dp": 0, "better": "low", "note": "터치 간격의 변동계수, 작을수록 고름"},
    {"id": "drb.steps_per_touch", "name": "잔발", "axis": "perf", "unit": "걸음/터치", "trust": "mid",
     "calc": {"op": "val", "a": "steps_per_touch"}, "ref": "R6", "dp": 2, "better": "low"},
    {"id": "drb.step_rate", "name": "걸음 빈도", "axis": "perf", "unit": "걸음/초", "trust": "mid",
     "calc": {"op": "val", "a": "step_rate"}, "ref": "R6", "dp": 2, "better": "high"},
    {"id": "drb.elastic", "name": "탄력성", "axis": "perf", "unit": "%", "trust": "mid",
     "calc": {"op": "val", "a": "elastic"}, "dp": 0, "better": "high", "note": "꺾을 때 속도를 얼마나 지키나"},
    {"id": "drb.ball_dist", "name": "볼 간수", "axis": "perf", "unit": "키 비율", "trust": "ref",
     "calc": {"op": "val", "a": "ball_dist"}, "dp": 3, "better": "low", "note": "공은 바닥, 발은 공중이라 참고값"},
    {"id": "drb.trunk_roll", "name": "상체 밸런스", "axis": "pose", "unit": "°", "trust": "high", "cam": ["front", "back"],
     "calc": {"op": "val", "a": "trunk_roll"}, "ref": "R7", "dp": 1, "better": "low", "note": "몸통 좌우 기울기 P90"},
    {"id": "drb.com_bob", "name": "무게축 흔들림", "axis": "pose", "unit": "키 비율", "trust": "mid",
     "calc": {"op": "val", "a": "com_bob"}, "ref": "R6", "dp": 3, "better": "low"},
    {"id": "drb.com_h", "name": "무게축 높이", "axis": "pose", "unit": "키 비율", "trust": "mid",
     "calc": {"op": "val", "a": "com_h"}, "dp": 3, "better": "low"},
    {"id": "drb.head_up", "name": "헤드업", "axis": "pose", "unit": "%", "trust": "ref", "cam": ["front", "diag", "side"],
     "calc": {"op": "val", "a": "head_up"}, "ref": "R8", "dp": 0, "better": "high", "note": "고개 방향만 보임(시선은 모름)"},
    {"id": "drb.foot_ratio", "name": "양발 사용(왼발 비율)", "axis": "pose", "unit": "%", "trust": "mid",
     "calc": {"op": "val", "a": "foot_ratio"}, "ref": "R9", "dp": 0,
     "score": {"lo": 35, "hi": 65, "t": 25},
     "fix": {"any": "한 발만 씁니다. 오른발 두 번, 왼발 두 번처럼 정해서 연습하세요."}}
  ],
  "refs": {
    "R1": {"text": "슬라럼 왕복 공 있이 U14 10.22±0.52초, 공 없이 6.16±0.17초", "src": "Milanović 외 2025", "url": "https://casopisi.junis.ni.ac.rs/index.php/FUPhysEdSport/article/download/13598/5715"},
    "R2": {"text": "드리블 손실(슬라럼 왕복) U14 4.06±0.53초", "src": "Milanović 외 2025", "url": "https://casopisi.junis.ni.ac.rs/index.php/FUPhysEdSport/article/download/13598/5715"},
    "R3": {"text": "20m 콘 드리블 평균 2.7±0.2 m/s", "src": "Rodriguez-Giustiniani 외 2021", "url": "https://dspace.stir.ac.uk/bitstream/1893/33225/1/Rodriguez-Giustiniani-etal-SMF-2021.pdf"},
    "R4": {"text": "보정 시간 = 시간 + 0.1초 × 콘 건드림", "src": "곡선 드리블 시험", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12015842/"},
    "R5": {"text": "초당 터치 빠른 집단 3.0±0.1, 느린 집단 2.3±0.2", "src": "Zago 외 2016", "url": "https://lida.sport-iat.de/ta/Record/4038745?lng=en"},
    "R6": {"text": "빠른 집단이 걸음 빈도 약 20% 높고 무게 중심 흔들림이 작음", "src": "Zago 외 2016", "url": "https://lida.sport-iat.de/ta/Record/4038745?lng=en"},
    "R7": {"text": "상체 기울기 P90 이 클수록 1대1 드리블 실패와 관련(기준 각도 없음)", "src": "arXiv 2506.22503", "url": "https://arxiv.org/html/2506.22503v1"},
    "R8": {"text": "고개를 들고 앞을 보며 굳지 않은 자세(정성)", "src": "FIFA 훈련 자료", "url": "https://www.fifatrainingcentre.com/media/native/test/FIFA_Session_Plan_branco-ball-mastering-new.pdf"},
    "R9": {"text": "반대발 사용이 적을수록 전술 효율이 낮았음(유소년)", "src": "Mattos dos Reis 2023", "url": "https://hrcak.srce.hr/file/446881"}
  },
  "engine": {
    "_note": "단위: 길이 = 키 비율, 속도 = 키/초, 시간 = 초. 첫 판 값이라 정답 도구 시험(lesson-build.md 7절)으로 맞춘다.",
    "vis_min": 0.5, "gap_fill_sec": 0.1, "ball_gap_sec": 0.2, "ball_conf_min": 0.3, "ball_jump": 2.5, "ball_jump_win": 0.15,
    "euro_min_cutoff": 1.0, "euro_beta": 0.05,
    "contact_h": 0.02, "contact_v": 1.5,
    "touch_dist": 0.10, "touch_gap": 0.25, "touch_dv": 0.15, "touch_ddeg": 20, "vel_win": 0.1, "ball_still": 0.3,
    "impact_ratio": 2.0, "impact_min_v": 3.0,
    "cut_deg": 45, "cut_win": 0.2, "move_v": 0.3,
    "stop_v": 0.15, "stop_min": 0.3,
    "view_front_shw": 0.16, "view_side_shw": 0.08,
    "calib_tol": 0.10, "head_up_drop": 0.03,
    "drb_touch_gap": 1.5, "drb_min_touches": 4
  }
